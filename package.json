{
  "name": "dsh-todolist",
  "version": "1.0.0",
  "type": "module",
  "description": "Queue your next prompts while the agent works — it runs them one by one on autopilot, starting a todo the moment a turn ends.",
  "license": "MIT",
  "author": "omnijk",
  "homepage": "https://github.com/omnijk/dsh-todolist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnijk/dsh-todolist.git"
  },
  "bugs": {
    "url": "https://github.com/omnijk/dsh-todolist/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo",
    "queue",
    "prompt",
    "workflow"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/zh.json",
    "locale/en.json",
    "docs/DETAIL.md",
    "icon.svg",
    "assets",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
